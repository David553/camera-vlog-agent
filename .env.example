# agent 大脑：任意 OpenAI 兼容文本模型（必需）
AGENT_API_KEY=sk-your-key
AGENT_BASE_URL=https://api.example.com/v1
AGENT_MODEL=glm-5.3

# 视觉模型：OpenAI 兼容、支持图片输入（可选；不填则降级为文本推断标签 provisional=true）
# 例：阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen3-vl-plus
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=qwen3-vl-plus

# 外部工具路径（已在 PATH 里可留空；GO2RTC_CONFIG 留空默认用项目内 go2rtc.yaml）
FFMPEG_PATH=
GO2RTC_PATH=
GO2RTC_CONFIG=
# 已有 opencv-python/numpy 的 site-packages 目录可填这里，否则用系统 python 环境
PYTHON_PACKAGES=

RECORD_SECONDS=60
SEGMENT_SECONDS=10